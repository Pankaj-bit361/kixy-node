# Copy the lines you need into your environment (the server does not read .env files itself).

# PostgreSQL 16. The database is created by `npm run db:setup` if it does not exist.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/kixy

HOST=0.0.0.0
PORT=8080
# Job files (captions, images, PDFs) live here, one folder per job.
DATA_DIR=data
# Required in production: a long random string used to sign session tokens.
JWT_SECRET=
SIGNUP_CREDITS=60
ALLOW_DEMO_TOPUP=true
WORKER_CONCURRENCY=2
MAX_BODY_MB=25
# Set to your web app's origin to allow browser calls from it.
CORS_ORIGIN=
CAPTION_FONT=Inter

# Optional providers. With none set, everything still works: clips come from the built-in
# picker, images are placeholder art and storyboards have no narration audio.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Force a provider: anthropic | openai | none, openai | placeholder, openai | none.
LLM_PROVIDER=
IMAGE_PROVIDER=
TTS_PROVIDER=
